# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 커밋하지 않습니다)

# 1 이면 가상 데이터로 화면/계산만 확인합니다.
DEMO_MODE=0

# scrape(기본): 공개 검색 페이지 스크래핑 / api: 공식 API / auto: 키가 있으면 API, 없으면 스크래핑
CONNECTOR_MODE=scrape
# 같은 사이트에 보내는 요청 사이 최소 간격(초)과 사이트당 검색어 수
SCRAPE_MIN_INTERVAL_SEC=3
SCRAPE_MAX_QUERIES=1

# ---- 아래 API 키는 CONNECTOR_MODE=api 또는 auto 일 때만 사용 ----

# 네이버 검색 Open API  https://developers.naver.com  (애플리케이션 등록 → 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡 파트너스 Open API  https://partners.coupang.com
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 11번가 Open API
ELEVENST_API_KEY=

# 도매꾹 / 도매매 Open API (같은 키 사용)
DOMEGGOOK_API_KEY=

# 기타
CACHE_TTL_SEC=1800
SITE_TIMEOUT_SEC=25
CORS_ORIGINS=http://localhost:5173

# ---- Supabase (선택: 로그인 + 검색/가격 이력 저장) ----
# Supabase 대시보드 → Project Settings → API (Data API) 에서 확인
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키는 비밀 키입니다. 백엔드에만 두고 Git/프런트엔드에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 1 이면 로그인한 사용자만 사용 가능
REQUIRE_AUTH=0
